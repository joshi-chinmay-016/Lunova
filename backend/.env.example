# ==============================================================================
# Lunova Unified Environment Configuration Reference
# Note: Root .env is now the single source of truth for the entire application.
# Copy the root .env.example to .env in the project root.
# ==============================================================================

# Platform & Server Settings
PROJECT_NAME="Lunova API"
ENVIRONMENT="development"
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lunova
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET_KEY=supersecretkey_for_development_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / LLM & Knowledge Processing Settings
LLM_PROVIDER=mock
LLM_MODEL=default-model
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Proposal Safety Limits & Test Flags
MAX_PROPOSAL_INPUT_CHARS=50000
RUN_LIVE_LLM_TESTS=0

# Gmail / Google OAuth & Token Encryption Configuration
# Note: GOOGLE_* and GMAIL_* environment variable aliases are both supported.
# Secure key generation: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here

# Local Development Bootstrap (Disabled in Production)
DEV_BOOTSTRAP_ENABLED=false
DEV_BOOTSTRAP_SECRET=
INITIAL_ADMIN_EMAIL=admin@lunetron.com
INITIAL_ADMIN_PASSWORD=
