# Lunova Intelligence Environment Configuration
# Copy this file to .env for local development with real APIs.
# NEVER commit .env with real credentials.

# LLM Provider selection: "mock" (default) or "gemini"
LLM_PROVIDER=mock

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Proposal Safety Limits
MAX_PROPOSAL_INPUT_CHARS=50000

# Testing Flags: Set to 1 to run live API tests against configured Gemini API Key
RUN_LIVE_LLM_TESTS=0

# Gmail OAuth & Token Encryption Configuration
# Secure key generation: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here
